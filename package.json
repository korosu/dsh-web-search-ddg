{
  "name": "dsh-web-search-ddg",
  "version": "0.1.3",
  "description": "Zero-token DuckDuckGo HTML-scrape search provider for the DeepSeek Harness web capability seam (ctx.web): no API key, no auxiliary model request.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "author": "korosu",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "web-search",
    "duckduckgo",
    "ddg",
    "search-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/korosu/dsh-web-search-ddg.git"
  },
  "bugs": {
    "url": "https://github.com/korosu/dsh-web-search-ddg/issues"
  },
  "homepage": "https://github.com/korosu/dsh-web-search-ddg#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.7.0",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "cheerio": "^1.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.1",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-test-isolation=none --test tests/ddg.spec.ts tests/ddg.e2e.ts",
    "test:e2e": "node --experimental-test-isolation=none --test tests/ddg.e2e.ts"
  }
}
